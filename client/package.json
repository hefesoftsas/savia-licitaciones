{
  "name": "savia-licitaciones",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Savia Licitaciones — interfaz web y servicios compartidos del runner",
  "author": "mark",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && pnpm run build:web",
    "audit:strict": "pnpm audit --audit-level=moderate",
    "setup:client": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "prepare-agent-tools": "node scripts/prepare-agent-tools.cjs",
    "prepare-openxml-helper": "node scripts/prepare-openxml-helper.cjs",
    "verify-agent-tools": "node scripts/verify-agent-tools.cjs",
    "build:web": "node scripts/generate-pi-model-catalog.mjs --check && vite build --config vite.web.config.ts"
  },
  "build": {
    "appId": "app.savia.licitaciones",
    "productName": "Savia Licitaciones",
    "copyright": "Copyright © 2026 mark",
    "asar": true,
    "extraResources": [
      {
        "from": "../tools/libreoffice-offline/.runtime/assets",
        "to": "libreoffice-assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "brand.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "vendor/agent-tools/win32-${arch}",
          "to": "agent-tools/win32-${arch}",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "vendor/openxml-tools/win32-${arch}",
          "to": "openxml-tools/win32-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null,
      "category": "public.app-category.business",
      "extraResources": [
        {
          "from": "vendor/agent-tools/darwin-${arch}",
          "to": "agent-tools/darwin-${arch}",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "vendor/openxml-tools/darwin-${arch}",
          "to": "openxml-tools/darwin-${arch}",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "backgroundColor": "#f4f7f4",
      "iconSize": 88,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 170,
          "y": 360,
          "type": "file"
        },
        {
          "x": 520,
          "y": 360,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 112,
          "y": 318,
          "type": "file",
          "path": "assets/macos-dmg/Instalacion-macOS.txt",
          "name": "Instalacion-macOS.txt"
        }
      ]
    },
    "artifactName": "Savia-Licitaciones-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@docx-editor.dev/core": "2.15.0",
    "@docx-editor.dev/react": "2.15.0",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@napi-rs/canvas": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "https://codeload.github.com/WiseLibs/better-sqlite3/tar.gz/refs/tags/v12.12.0",
    "cfb": "^1.2.2",
    "chardet": "^2.1.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "electron-updater": "^6.8.3",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.2",
    "lucide-react": "^1.63.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "markdown-it-cjk-friendly": "^2.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "mime-types": "^3.0.2",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-joyride": "3.2.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "6.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typebox": "^1.1.38",
    "undici": "^7.25.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.8.1",
    "js-yaml": "^4.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
